# Variables de Entorno - Producción
# Club Deportivo Creeser

# URL de la aplicación
VITE_APP_URL=https://academia-creeser.vercel.app
VITE_APP_NAME=Club Deportivo Academia Creeser

# API URL (cuando el backend esté disponible)
# VITE_API_URL=https://api.creeser.cl

# Información de contacto (sincronizado con datos reales de la academia)
VITE_CONTACT_EMAIL=espaciocreeser.contacto@gmail.com
VITE_CONTACT_PHONE=+56982211715

# Paneles internos deshabilitados en producción hasta tener backend real
# Cambiar a true solo cuando exista autenticación JWT server-side
VITE_ENABLE_INTERNAL_PANELS=false

# Redes sociales
VITE_INSTAGRAM_URL=https://www.instagram.com/creesertkd/
VITE_FACEBOOK_URL=https://www.facebook.com/p/Espacio-Creeser-100086943102222/

# Google Analytics (configurar en Vercel Environment Variables)
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Google Places API (configurar en Vercel Environment Variables)
# VITE_GOOGLE_PLACES_PLACE_ID=ChIJ...

# Sentry (configurar en Vercel Environment Variables)
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Modo
VITE_MODE=production
