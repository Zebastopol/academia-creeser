# Variables de Entorno - Producción
# Club Deportivo Creeser

# URL de la aplicación
VITE_APP_URL=https://academia-creeser.vercel.app
VITE_APP_NAME=Club Deportivo Academia Creeser

# API URL (cuando el backend esté disponible)
# VITE_API_URL=https://api.creeser.cl

# Información de contacto (sincronizado con datos reales de la academia)
VITE_CONTACT_EMAIL=espaciocreeser.contacto@gmail.com
VITE_CONTACT_PHONE=+56982211715

# Paneles internos accesibles en producción con banner "En Construcción".
# El acceso se controla exclusivamente por el rol del usuario (isAdmin/isInstructor).
# NOTA: mientras no exista backend real con JWT, los paneles muestran datos mock.
VITE_ENABLE_INTERNAL_PANELS=true

# Redes sociales
VITE_INSTAGRAM_URL=https://www.instagram.com/creesertkd/
VITE_FACEBOOK_URL=https://www.facebook.com/p/Espacio-Creeser-100086943102222/

# --- Variables SERVER-SIDE (configurar en Vercel > Environment Variables) ---
# NO usar prefijo VITE_ para credenciales — nunca deben entrar al bundle del cliente.
#
# Google Places API (usadas por /api/reviews):
#   GOOGLE_PLACES_API_KEY
#   GOOGLE_PLACES_ID
#
# Vercel Web Analytics (usadas por /api/traffic-metrics):
#   VERCEL_TOKEN           (Personal / Team Access Token con scope analytics:read)
#   VERCEL_PROJECT_ID
#   VERCEL_TEAM_ID         (opcional, solo si el proyecto pertenece a un team)

# Sentry (configurar en Vercel Environment Variables)
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Modo
VITE_MODE=production
