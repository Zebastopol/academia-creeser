# Variables de Entorno - Academia Creeser
# Copiar a .env.development o .env.production y completar valores

# URL de la aplicación
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=Club Deportivo Academia Creeser

# API URL (backend)
# VITE_API_URL=http://localhost:3001/api

# Información de contacto
VITE_CONTACT_EMAIL=espaciocreeser.contacto@gmail.com
VITE_CONTACT_PHONE=+56982211715

# Habilitar paneles internos (admin/instructor)
# true = paneles accesibles, false = deshabilitados
VITE_ENABLE_INTERNAL_PANELS=true

# Redes sociales
VITE_INSTAGRAM_URL=https://www.instagram.com/creesertkd/
VITE_FACEBOOK_URL=https://www.facebook.com/p/Espacio-Creeser-100086943102222/

# Google Analytics
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Google Places
# VITE_GOOGLE_PLACES_PLACE_ID=ChIJ...

# Sentry
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Modo
VITE_MODE=development
